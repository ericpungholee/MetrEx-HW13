# Copy to .env (backend, scripts) and app/.env.local (frontend). Never commit real values.

# --- Cluster ---
SOLANA_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
RPC_URL_BACKUP=

# --- Program + mint (filled in after Gate 2 deploy / setup-devnet) ---
PROGRAM_ID=
MUSD_MINT=

# --- Keypair paths (server-only; files live outside the repo) ---
METREX_KEY_DIR=~/.config/metrex
ADMIN_KEYPAIR=~/.config/metrex/admin.json
ORACLE_KEYPAIR=~/.config/metrex/oracle.json
CONTROLLER_KEYPAIR=~/.config/metrex/controller.json
MINT_AUTHORITY_KEYPAIR=~/.config/metrex/mint-authority.json
FAUCET_KEYPAIR=~/.config/metrex/faucet.json
BOT_A_KEYPAIR=~/.config/metrex/bot-a.json
BOT_B_KEYPAIR=~/.config/metrex/bot-b.json
BOT_C_KEYPAIR=~/.config/metrex/bot-c.json

# --- Route handlers ---
# Shared secret sent as the x-demo-password header to /api/demo/close and /api/oracle/resolve
DEMO_PASSWORD=

# --- Frontend (public) ---
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_MUSD_MINT=
# 1 = labelled fixture data, dev only. Production builds must fail with this on.
NEXT_PUBLIC_USE_FIXTURES=0
