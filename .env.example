# Copy to .env (backend, scripts) and app/.env.local (frontend). Never commit real values.

# --- Cluster ---
SOLANA_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
RPC_URL_BACKUP=
# Client-side request caps per process (app server incl. /api/rpc, bots, keeper, scripts). Hosted tiers often allow ~1
# getProgramAccounts per second; the workers need none in steady state. Unset = no cap (local).
RPC_MAX_RPS=
RPC_MAX_SCAN_RPS=

# --- Program + mint (filled in after Gate 2 deploy / setup-devnet) ---
PROGRAM_ID=
MUSD_MINT=

# --- Keypair paths (server-only; files live outside the repo) ---
METREX_KEY_DIR=~/.config/metrex
ADMIN_KEYPAIR=~/.config/metrex/admin.json
ORACLE_KEYPAIR=~/.config/metrex/oracle.json
CONTROLLER_KEYPAIR=~/.config/metrex/controller.json
MINT_AUTHORITY_KEYPAIR=~/.config/metrex/mint-authority.json
FAUCET_KEYPAIR=~/.config/metrex/faucet.json
BOT_A_KEYPAIR=~/.config/metrex/bot-a.json
BOT_B_KEYPAIR=~/.config/metrex/bot-b.json
BOT_C_KEYPAIR=~/.config/metrex/bot-c.json

# --- Frontend (public) ---
# Leave unset: the browser uses this app's /api/rpc proxy (RPC_URL stays server-side).
# Only ever set a key-free URL here; it is bundled into the browser.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_MUSD_MINT=
# 1 = labelled fixture data, dev only. Production builds must fail with this on.
NEXT_PUBLIC_USE_FIXTURES=0
# Enable the UI controls after the Tier 2 program upgrade.
NEXT_PUBLIC_ENABLE_TIER2=0

# --- Workstream D additions ---
# Extra keypair paths (defaults: $METREX_KEY_DIR/<name>.json)
DEPLOYER_KEYPAIR=~/.config/metrex/deployer.json
HOMEOWNER_DEMO_KEYPAIR=~/.config/metrex/homeowner-demo.json
JUDGE_1_KEYPAIR=~/.config/metrex/judge-1.json
JUDGE_2_KEYPAIR=~/.config/metrex/judge-2.json
JUDGE_3_KEYPAIR=~/.config/metrex/judge-3.json
# Optional overrides for route handlers / scripts run outside the repo root
METREX_REPO_ROOT=
METREX_DATA_DIR=
# Private mount for production settlement. Contains scenarios.json, normalized geometry and evidence/.
METREX_ORACLE_DATA_DIR=
METREX_IDL_PATH=
# Bots: 1 = Tier 2 requoting + Risk-side listings (spec §7.1). Off by default.
BOTS_TIER2=0
# Bots: Risk-side listing price = collateral + this % of premium (spec §7.1)
BOTS_LISTING_PREMIUM_PCT=50
# Bots: poll interval in ms (spec §7: 3 s)
BOTS_POLL_MS=3000
