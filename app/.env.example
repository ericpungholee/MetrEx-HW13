# Copy to app/.env.local. Keep credentials out of NEXT_PUBLIC_* and Git.
SOLANA_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
RPC_URL_BACKUP=
RPC_MAX_RPS=6
RPC_MAX_SCAN_RPS=1
METREX_APP_ORIGIN=http://127.0.0.1:3015
# Optional. By default the browser uses the same-origin /api/rpc proxy.
NEXT_PUBLIC_RPC_URL=
# Fixture data is available in development only.
NEXT_PUBLIC_USE_FIXTURES=0
