# Copy to app/.env.local. Public values only; never put keys here.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Defaults to the IDL address when empty.
NEXT_PUBLIC_PROGRAM_ID=
# Display hint only; the mint actually used is always read from the on-chain Config PDA.
NEXT_PUBLIC_MUSD_MINT=
# 1 = labelled fixture data, dev only. `next build` fails with this on.
NEXT_PUBLIC_USE_FIXTURES=0
